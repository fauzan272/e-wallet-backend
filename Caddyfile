# Caddy: menerima request dari internet, lalu meneruskannya ke container backend ("app").
# Caddy otomatis membuat dan memperpanjang sertifikat HTTPS gratis dari Let's Encrypt,
# dan mengalihkan http:// ke https://.

# Pengaturan yang dipakai oleh setiap alamat di bawah.
(backend) {
	reverse_proxy app-new-app-1:5000
	encode gzip
	request_body {
		max_size 1MB
	}
}

# Subdomain API kamu di port kustom 8443
api-two.fauzanproject.my.id {
	import backend
}

# Untuk mencoba di laptop: http://localhost
http://localhost {
	import backend
}
