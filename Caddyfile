# Caddy: menerima request dari internet, lalu meneruskannya ke container backend ("app").
# Caddy otomatis membuat dan memperpanjang sertifikat HTTPS gratis dari Let's Encrypt,
# dan mengalihkan http:// ke https://.

# Pengaturan yang dipakai oleh setiap alamat di bawah.
(backend) {
	# DIUBAH: Menggunakan app karena sekarang Caddy berjalan di dalam Docker bersama backend
	reverse_proxy app:5000

	encode gzip

	# Tolak body request yang terlalu besar.
	request_body {
		max_size 1MB
	}
}

# Subdomain API kamu.
# Ditambahkan https:// di depan agar Caddy otomatis memproses SSL/HTTPS pada port 5000
https://api-two.fauzanproject.my.id {
	import backend
}

# Untuk mencoba di laptop: http://localhost
http://localhost {
	import backend
}
